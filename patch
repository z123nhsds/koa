const { describe, it } = require('node:test')
const request = require('supertest')
const assert = require('node:assert/strict')
const Koa = require('../..')

describe('bug: response content-type value amount as one', () => {
  const app = new Koa()

  it('should throw TypeError when accessing response.type after setting Content-Type to array (bug before fix)', () => {
    app.use((ctx) => {
      ctx.set('Content-Type', ['image/jpg', 'application/json'])
      ctx.body = {}
      const type = ctx.type
      assert.fail('should not reach here - TypeError: type.split is not a function expected')
    })

    return request(app.callback())
      .get('/')
      .expect(500)
  })
})
