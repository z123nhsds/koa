 const Koa = require('../..')
 
+function syncCompose (fns) {
+  return function (ctx) {
+    return dispatch(0)
+
+    function dispatch (index) {
+      const fn = fns[index]
+      if (!fn) return
+      return fn(ctx, function next () {
+        return dispatch(index + 1)
+      })
+    }
+  }
+}
+
 describe('app.compose', () => {
   it('should work with default compose ', async () => {
     const app = new Koa()
@@ -64,4 +78,28 @@ describe('app.compose', () => {
